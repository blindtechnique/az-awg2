[Unit]
Description=AntiZapret-AWG Telegram bot
After=network-online.target antizapret.service
Wants=network-online.target

[Service]
Type=simple
# Токен — это фактически пароль от сервера, а юниты в /etc/systemd/system
# читаются всеми (права 644). Поэтому все переменные, включая токен, вынесены
# в отдельный файл с правами 600 — его создаёт установщик.
#
# Бот пока работает от root: он дёргает client.sh ванили, правит конфиги в
# /etc/amnezia/amneziawg и перезапускает юниты. Понижение до отдельного
# пользователя требует перевода всех этих вызовов на sudo с точечными
# правилами — это отдельный шаг, чтобы не сломать функциональность.
EnvironmentFile=/opt/antizapret-awg/bot.env
ExecStart=/opt/antizapret-awg/venv/bin/python /opt/antizapret-awg/bot/awg_bot.py
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
